# Public build configuration only. Never put private keys, wallet seeds or bearer intent IDs here.
# Live is the default; use demo explicitly for simulated UI flows.
VITE_BRIDGE_MODE=live

# Real Sepolia deployment using Automata. Do not substitute the unsafe test deployment.
VITE_BRIDGE_ADDRESS=0x1C833095c0cd2d50e08dF0031052A865f026C319
# Set the verified creation block of this Bridge/Registry deployment.
VITE_DEPLOYMENT_BLOCK=12076955

# Public raw TLS ingress must terminate inside the enclave.
# Nym verifies the SPKI against finalized registry state before sending HTTP.
VITE_API_BASE=https://13.204.222.79:8443
VITE_REGISTRY_ADDRESS=0xF83171035445b01B0F70f71Dc2aff923f681D279
# Reviewed keccak256 of deployed registry runtime bytecode; do not learn from an untrusted API.
VITE_REGISTRY_CODE_HASH=0x66cab6dbd68363e811bb0af59a0ddcb8bb8df1b4147d1295708373bf0d76323e
VITE_VAULT_ID=0x71679aaf461fbba0d7430be3fc1f8433554fd58c96c039bda07c8a8b2df58f41

# Must match the vault's reviewed fee policy. Values are integer XMR atomic units (12 decimals).
VITE_FEE_TERMS_HASH=0x5cec35ad7968656013945b5b294a5f148ca893206a4352b1c3303a61994f1871
VITE_FIXED_FEE_ATOMIC=1000000000
VITE_MIN_REDEEM_ATOMIC=1000000001
