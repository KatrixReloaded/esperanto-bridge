   await setupMixTunnel(opts);
   return mixFetch;
 };
+
+/** Authenticates the TLS peer before sending HTTP; no redirects, pooling or retry. */
+export const mixFetchPinned = async (url: string, init: RequestInit, origin: string, spki: string): Promise<Response> => {
+  const tunnel = await getMixTunnel();
+  const raw = await tunnel.mixFetchPinned(url, init, origin, spki);
+  return new Response(raw.body as BodyInit, {
+    status: raw.status, statusText: raw.statusText, headers: new Headers(raw.headers),
+  });
+};
