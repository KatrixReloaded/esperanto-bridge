+/// Fresh, non-pooled TLS connection authenticated by the caller's registry SPKI.
+#[wasm_bindgen(js_name = "mixFetchPinned")]
+pub fn mix_fetch_pinned(url: String, init: JsValue, origin: String, spki: String) -> js_sys::Promise {
+    future_to_promise(async move {
+        let tunnel = crate::ready_tunnel()?;
+        fetch::fetch_pinned(tunnel, &url, &init, &origin, &spki).await.map_err(Into::into)
+    })
+}
