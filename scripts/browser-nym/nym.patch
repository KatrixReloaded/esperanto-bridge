diff --git a/wasm/smolmix/src/fetch.rs b/wasm/smolmix/src/fetch.rs
index 0eb4a88..0a15a66 100644
--- a/wasm/smolmix/src/fetch.rs
+++ b/wasm/smolmix/src/fetch.rs
@@ -33,6 +33,39 @@ struct FetchInit {
     body: Option<Vec<u8>>,
 }
 
+/// Private enclave API requests never reuse the ordinary (host,port) pool.
+/// No HTTP bytes leave until TLS proves possession of the pinned private key.
+#[cfg(feature = "fetch")]
+pub async fn fetch_pinned(tunnel: &WasmTunnel, url_str: &str, init: &JsValue, origin: &str, spki: &str)
+    -> Result<JsValue, FetchError> {
+    let url = Url::parse(url_str)?;
+    let expected = Url::parse(origin)?;
+    if expected.scheme() != "https" || expected.as_str() != format!("{}/", expected.origin().ascii_serialization())
+        || url.origin() != expected.origin() || !url.username().is_empty() || url.password().is_some()
+        || url.fragment().is_some() || spki.len() != 64 {
+        return Err(FetchError::Http("invalid pinned HTTPS origin or SPKI".into()));
+    }
+    let mut pin = [0u8; 32];
+    for (i, byte) in pin.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(spki.get(i*2..i*2+2).ok_or_else(|| FetchError::Http("invalid SPKI".into()))?,16)
+            .map_err(|_| FetchError::Http("invalid SPKI".into()))?;
+    }
+    if pin == [0u8;32] { return Err(FetchError::Http("empty SPKI".into())); }
+    let opts = parse_init(init)?;
+    if !matches!(opts.method.as_str(), "GET" | "POST") || opts.body.as_ref().is_some_and(|b| b.len()>4096)
+        || opts.headers.iter().any(|(name,_)| ["host","connection","content-length","transfer-encoding"].iter().any(|bad| name.eq_ignore_ascii_case(bad))) {
+        return Err(FetchError::Http("invalid pinned request".into()));
+    }
+    let host = url.host_str().ok_or_else(|| FetchError::Http("missing host".into()))?;
+    let addr = SocketAddr::new(dns::resolve(tunnel, host).await?, url.port_or_known_default().unwrap_or(443));
+    let tcp = tunnel.tcp_connect(addr).await.map_err(FetchError::Io)?;
+    let tls = tls::connect_pinned(tcp, host, pin).await?;
+    let (response, _, _connection) = http::request(PooledConn::Tls(tls), &opts.method, &url,
+        &opts.headers, opts.body.as_deref(), Some(65536)).await?;
+    if (300..400).contains(&response.status) { return Err(FetchError::Http("pinned request redirect forbidden".into())); }
+    serialise_response(&response)
+}
