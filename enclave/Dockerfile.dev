# Local development only: this builder is produced by the production Dockerfile's
# rust-build target. It is a build cache, not an attested or distributable image.
ARG CWXMR_BUILDER_IMAGE=cwxmr-rust-build:local
FROM ${CWXMR_BUILDER_IMAGE} AS dev-build
ARG CARGO_BUILD_JOBS=2
WORKDIR /src/dev-service
COPY service/ ./
ENV CARGO_TARGET_DIR=/src/service/target
RUN cargo build --locked --release --package zz-watcher --bin zz-dev --features unsafe-test

FROM node:24.11.1-bookworm-slim@sha256:48abc13a19400ca3985071e287bd405a1d99306770eb81d61202fb6b65cf0b57
RUN rm -f /etc/apt/sources.list.d/debian.sources && printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261101T000000Z bookworm main' > /etc/apt/sources.list && apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=dev-build /src/service/target/release/zz-dev /usr/local/bin/zz-dev
ENTRYPOINT ["/usr/local/bin/zz-dev"]
